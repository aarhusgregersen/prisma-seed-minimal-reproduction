{
  "name": "prisma-seed-repro",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal reproduction for Prisma 6 seed command issue",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.7.0"
  },
  "scripts": {
    "prepare": "husky",
    "db:generate": "pnpm --filter @repro/db db:generate",
    "db:seed": "pnpm --filter @repro/db with-env pnpx prisma db seed",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@repro/db": "workspace:*",
    "@types/node": "24.10.0",
    "husky": "^9.1.7"
  }
}
